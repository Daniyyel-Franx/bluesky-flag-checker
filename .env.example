# Copy this file to .env and fill in the values for local development.
# On Render, set these as environment variables in the dashboard instead.

# A long, random secret string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# IMPORTANT: change this before deploying. Anyone who knows this value can forge session cookies.
COOKIE_SECRET=42784304f9d8e4fed696ea50e07ffff0537ed7e6909319553d41137f211a881362286bb2f5c74501dd83d2ecbcf413a7

# Port to listen on (Render sets this automatically; only needed locally)
PORT=3000
